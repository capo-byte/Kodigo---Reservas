{
  "name": "kodigo-reservas",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --env-file-if-exists=.env --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "fastify-raw-body": "^6.0.3",
    "pg": "^8.23.1",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
